# ---- Which backend? ----
# Leave everything empty in development to run on the built-in mock API (demo data, no backend needed).
#
# Real backend, option A (recommended in dev): let Vite forward /api so the browser sees ONE origin.
#   VITE_MOCK=false
#   VITE_DEV_PROXY=http://127.0.0.1:8790     (and set the backend's FRONTEND_ORIGIN=http://localhost:5173)
#
# Real backend, option B: call the backend directly (needs CORS + a same-site cookie, see LAUNCH_CHECKLIST.md)
#   VITE_MOCK=false
#   VITE_API_URL=http://127.0.0.1:8790       (open the app at http://127.0.0.1:5173, same host name)
#
# Production behind a reverse proxy that serves /api on the same origin: set VITE_MOCK=false and leave VITE_API_URL empty.

VITE_API_URL=
VITE_MOCK=
VITE_DEV_PROXY=

# Dev only. MUST be empty/false in production builds.
VITE_DEV_LOGIN=
VITE_SIMULATE_PAYMENTS=

# Link to your Telegram bot, e.g. https://t.me/your_bot (shown on the sign-in screen)
VITE_TELEGRAM_BOT_URL=
