# Used by Prisma CLI (migrations, seed) and Node scripts. NOT read by the Worker.
# Direct (non-Hyperdrive) connection string.
DATABASE_URL=postgresql://kobo:kobo@localhost:54329/kobo_exact

# Integration tests run against this database (migrated automatically by the test setup).
TEST_DATABASE_URL=postgresql://kobo:kobo@localhost:54329/kobo_exact_test

# Only for scripts/set-telegram-webhook.ts and scripts/sandbox-e2e.ts
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WORKER_URL=http://127.0.0.1:8790
KORA_SECRET_KEY=
