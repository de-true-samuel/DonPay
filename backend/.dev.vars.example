# Copy to .dev.vars for `wrangler dev`. These are the Worker's secrets in local development.
# In staging/production, set each one with: npx wrangler secret put NAME --env staging
KORA_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-random-string
ADMIN_SECRET=change-me-admin
# Clerk website sign-in (optional; leave both empty to keep Telegram/dev sign-in only).
# Clerk Dashboard → API keys. The publishable key also goes in frontend/.env.local as VITE_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
