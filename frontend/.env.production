# Used by `vite build` (the Cloudflare build). VITE_* values are baked in at build time.
# Real backend: same origin, forwarded by worker/index.js. Never fall back to demo data.
VITE_MOCK=false
VITE_API_URL=
# VITE_CLERK_PUBLISHABLE_KEY is set in the Cloudflare build settings (Variables), not here.
