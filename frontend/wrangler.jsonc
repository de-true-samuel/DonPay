{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paidar",
  "compatibility_date": "2024-11-01",
  "observability": {
    "enabled": true
  },
  // Serves the app and forwards backend routes (see worker/index.js).
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; every other request is served straight from ./dist.
    "run_worker_first": ["/api/*", "/p/*"]
  },
  "vars": {
    // The backend Worker's public address (it lives on another Cloudflare account, so no service binding).
    // PROXY_SECRET is a Worker secret: npx wrangler secret put PROXY_SECRET --name paidar
    "BACKEND_ORIGIN": "https://kobo-exact-staging.theibukunjames.workers.dev"
  }
}
