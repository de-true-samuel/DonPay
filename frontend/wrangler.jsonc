{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paidar",
  "compatibility_date": "2024-11-01",
  "observability": {
    "enabled": true
  },
  // Serves the app and forwards backend routes (see worker/index.js).
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; every other request is served straight from ./dist.
    "run_worker_first": ["/api/*", "/p/*"]
  },
  // The backend Worker (backend/wrangler.jsonc, env "staging"). Deploy the backend first.
  "services": [{ "binding": "BACKEND", "service": "kobo-exact-staging" }]
}
